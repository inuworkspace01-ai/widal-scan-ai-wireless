# Browser-safe configuration
NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_...

# One-time first-account setup only. Remove after bootstrap has completed.
BOOTSTRAP_SETUP_TOKEN=GENERATE_A_RANDOM_SECRET_AT_LEAST_32_CHARACTERS

# Supabase secret/service-role credentials are managed by Supabase Edge Functions.
# Never add them to NEXT_PUBLIC_ variables or commit them to this repository.
