# Public browser configuration
NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_...

# Server-only setup. Remove after initial account creation.
SUPABASE_SECRET_KEY=sb_secret_...
BOOTSTRAP_SETUP_TOKEN=GENERATE_A_RANDOM_SECRET_AT_LEAST_32_CHARACTERS

# Optional legacy server key instead of SUPABASE_SECRET_KEY:
# SUPABASE_SERVICE_ROLE_KEY=YOUR_LEGACY_SERVICE_ROLE_JWT
