# Public browser configuration
NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=YOUR_SUPABASE_PUBLISHABLE_KEY

# Server-only bootstrap configuration. Never prefix these with NEXT_PUBLIC_.
# Remove the final two secret variables after the first three accounts are created.
SUPABASE_SERVICE_ROLE_KEY=YOUR_SERVICE_ROLE_SECRET
BOOTSTRAP_SETUP_TOKEN=GENERATE_A_RANDOM_SECRET_AT_LEAST_32_CHARACTERS
